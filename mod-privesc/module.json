{
  "id": "privesc",
  "version": "1.0.0",
  "core": "2.2.0",
  "entry": "module:PrivescModule",
  "default_enabled": true,
  "read_paths": ["/var/log/audit"],
  "setup_option": "--configure-privesc",
  "settings": [
    {"key": "audit_log", "type": "path", "default": ""},
    {"key": "syslog_mode", "type": "choice", "choices": ["auto", "always", "never"], "default": "auto", "required": true},
    {"key": "syslog_file", "type": "path", "default": ""},
    {"key": "ignored_users", "type": "string", "default": "", "max_length": 500},
    {"key": "admin_groups", "type": "string", "default": "sudo,wheel,admin", "max_length": 200},
    {"key": "recon_window_seconds", "type": "integer", "default": 120, "min": 10, "max": 3600},
    {"key": "recon_threshold", "type": "integer", "default": 8, "min": 2, "max": 500},
    {"key": "recon_threshold_admins", "type": "integer", "default": 20, "min": 2, "max": 500},
    {"key": "enumeration_threshold", "type": "integer", "default": 40, "min": 5, "max": 1000},
    {"key": "learning_days", "type": "integer", "default": 3, "min": 0, "max": 365},
    {"key": "surface_scan_hours", "type": "integer", "default": 24, "min": 0, "max": 168},
    {"key": "scan_paths", "type": "string", "default": "/usr,/bin,/sbin,/lib,/lib64,/opt,/home,/srv,/tmp,/var/tmp,/dev/shm,/var/www,/etc", "max_length": 500},
    {"key": "discovery_interval_seconds", "type": "integer", "default": 300, "min": 60, "max": 86400}
  ]
}
